{
  "minLines": 10,
  "minTokens": 50,
  "mode": "mild",
  "crossFormats": "js-ts",
  "maxSize": "20mb",
  "reporters": ["json"],
  "ignore": [
    "**/node_modules/**",
    "**/.git/**",
    "**/dist/**",
    "**/out/**",
    "**/build/**",
    "**/release/**",
    "**/coverage/**",
    "**/vendor/**",
    "**/vendored/**",
    "**/generated/**",
    "**/fixtures/**",
    "**/__fixtures__/**",
    "**/__snapshots__/**",
    "**/*.snap",
    "**/*.min.*",
    "**/*.map",
    "packages/runtime/src/codex/protocol/**",
    "apps/desktop/src/main/db/migrations/**",
    "apps/desktop/src/main/provider-snapshots/**/*.json",
    "apps/desktop/src/main/provider-snapshots/*.json",
    "scripts/mutations/*/mutate.sh",
    "**/*.fixture.*",
    "**/*-fixture.*",
    "**/*-fixtures.*",
    "**/fixtures.ts",
    "**/.jscpd*/**",
    "**/reports/**",
    "pnpm-lock.yaml",
    "**/package-lock.json",
    "**/yarn.lock",
    "**/pnpm-lock.yaml",
    "**/go.sum",
    "scripts/mutations/ATTESTATION.json",
    "scripts/mutations/CENSUS.md",
    "**/evidence/**",
    "scripts/mutations/*/*results*.json",
    ".jscpd-baseline.json",
    ".jscpd.json",
    "docs/dry/**",
    "**/.jscpd-reports/**",
    "**/release-tooling-lock.json"
  ]
}
