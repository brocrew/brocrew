  "shared": { "fonts": { "body": ["Inter", "Avenir Next", "sans-serif"] } },
  "type": {
    "display": {
      "font": ["Avenir Next", "Avenir", "Inter"],
      "weight": 700,
      "letterSpacing": -0.01
    },
    "brand": { "font": ["Avenir Next"], "weight": 700 }
  },
  "titlebar": { "background": "#10132f", "ink": "#e9eaff" },
