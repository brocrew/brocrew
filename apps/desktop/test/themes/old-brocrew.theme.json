  "extends": "defined",
  "status": { "waiting": "#553500", "success": "#024a33", "danger": "#7a1824", "auto": "#663000" },
  "frame": { "ink": "#f1f2ff", "paper": "#14173a", "accent": "#ff8a5c" },
