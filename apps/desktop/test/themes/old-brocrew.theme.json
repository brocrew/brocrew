  },
  "conversation": {
    "background": {
      "color": "#fbfaf7",
      "layers": [
        { "image": "assets/network-light.png", "size": 280, "position": "top left", "repeat": true }
      ]
    }
  },
  "tokens": { "content": { "accent-text": "#c2410c" } }
