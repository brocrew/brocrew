{
  "name": "@brobot2/desktop",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "BroCrew",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "node ../../scripts/install-electron.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite build && electron .",
    "typecheck": "vue-tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "db:generate:unstamped": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "package": "electron-vite build && electron-builder --mac --arm64 --config electron-builder.yml",
    "package:win": "electron-vite build && electron-builder --win --x64 --config electron-builder.yml",
    "package:mac-beta": "electron-vite build && electron-builder --mac --arm64 --config electron-builder.yml -c.mac.identity=-"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.287",
    "@brobot2/orchestration": "workspace:*",
    "@brobot2/runtime": "workspace:*",
    "@brobot2/shared": "workspace:*",
    "@dagrejs/dagre": "3.1.1",
    "@vue-flow/core": "^1.48.2",
    "better-sqlite3": "^13.0.1",
    "drizzle-orm": "^0.45.2",
    "electron-updater": "6.8.10",
    "markdown-it": "^14.3.0",
    "vue": "^3.5.40",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "@openai/codex-darwin-arm64": "npm:@openai/codex@0.160.0-darwin-arm64",
    "@openai/codex-win32-x64": "npm:@openai/codex@0.160.0-win32-x64"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/browser": "4.1.10",
    "@vitest/browser-playwright": "4.1.10",
    "drizzle-kit": "^0.31.10",
    "electron": "^43.2.0",
    "electron-builder": "26.15.3",
    "electron-vite": "^5.0.0",
    "playwright": "1.62.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vue-tsc": "^3.3.8"
  }
}
