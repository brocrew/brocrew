    "major": 1,
    "minMinor": 0,
    "maxMinor": 0,
    "requiredFeatures": []
  },
  "dataSchema": 1,
  "files": [],
  "server": {
    "entry": "server.mjs",
    "mcpPath": "/mcp",
    "adminPath": "/v1"
  },
  "skills": [],
  "serviceTemplates": [],
  "ui": {
    "entry": "ui/index.html",
    "assets": [
      {
        "path": "ui/index.html",
        "mime": "text/html"
      },
      {
        "path": "ui/app.js",
        "mime": "text/javascript"
      },
      {
        "path": "ui/style.css",
        "mime": "text/css"
      }
    ],
    "methodSchemas": {
      "read": {
        "type": "object",
        "properties": {
          "surface": {
            "type": "string",
            "enum": ["chrome"],
            "maxLength": 6
          }
        },
        "required": ["surface"],
        "additionalProperties": false
      },
      "subscribe": {
        "type": "object",
        "properties": {
          "surface": {
            "type": "string",
            "enum": ["chrome"],
            "maxLength": 6
          }
        },
        "required": ["surface"],
        "additionalProperties": false
      },
      "unsubscribe": {
        "type": "object",
        "properties": {
          "subscriptionId": {
            "type": "string",
            "maxLength": 64
          }
        },
        "required": ["subscriptionId"],
        "additionalProperties": false
      },
      "proposeConfig": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": ["create-profile", "set-enabled", "open-window"],
            "maxLength": 32
          },
          "profile": {
            "type": "string",
            "maxLength": 32
          },
          "enabled": {
            "type": "boolean"
          }
        },
        "required": ["action", "profile"],
        "additionalProperties": false
      }
    },
    "texts": [
