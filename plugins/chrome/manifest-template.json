  "permissions": {
    "description": "Uses your installed Google Chrome with its own separate profiles. Agents can read pages, use sites and save downloads in the plugin's private storage. You choose which profiles agents may use.",
    "resources": [
      {
        "id": "browser-profiles",
        "label": "Enabled Chrome profiles",
        "read": true,
        "write": true
      }
    ]
