      "default": "./src/atomic-write.ts"
    },
    "./provider-home": {
      "types": "./src/internal/provider-home.ts",
      "default": "./src/internal/provider-home.ts"
    },
    "./managed-plugin-mcp": {
      "types": "./src/managed-plugin-mcp.ts",
      "default": "./src/managed-plugin-mcp.ts"
    },
    "./managed-plugin-session": {
      "types": "./src/managed-plugin-session.ts",
      "default": "./src/managed-plugin-session.ts"
    },
    "./plugin-failure": {
      "types": "./src/managed-plugin-failure.ts",
      "default": "./src/managed-plugin-failure.ts"
    },
    "./claude": {
      "types": "./src/claude.ts",
      "default": "./src/claude.ts"
    },
    "./codex": {
      "types": "./src/codex.ts",
      "default": "./src/codex.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.287",
    "@brobot2/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "1.29.0",
    "smol-toml": "1.7.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
